# Copy to .env to override the defaults baked into docker-compose.yml.
#
# The stack runs without this file — every variable below already has a working
# development default. It exists to document what is configurable and to give
# you somewhere to put a real secret.

# ---- Database -------------------------------------------------------------

POSTGRES_DB=atrium
POSTGRES_USER=atrium
POSTGRES_PASSWORD=atrium_dev_pass

# Host port for psql access. Change if 5432 is already taken locally.
POSTGRES_PORT=5432

# The hostname here is the compose service name, not localhost: this URL is
# resolved from inside the api container. To run the server directly on your
# host instead, point it at localhost:
#   postgres://atrium:atrium_dev_pass@localhost:5432/atrium?sslmode=disable
DATABASE_URL=postgres://atrium:atrium_dev_pass@postgres:5432/atrium?sslmode=disable

# ---- API ------------------------------------------------------------------

API_PORT=8080

# Signs session tokens. Must be at least 32 bytes or the server refuses to
# start — a short HMAC key weakens the signature, and a default secret that
# works locally is exactly how one reaches production. Generate a real one:
#   openssl rand -base64 32
JWT_SECRET=dev_only_secret_at_least_32_bytes_long

# Exposes POST /api/auth/demo-login, which signs in as a seeded account with no
# password. Convenient for review, unacceptable in production: it is an
# unauthenticated route that hands out a valid session. The application defaults
# it to false; compose turns it on because compose is a dev environment.
DEMO_LOGIN_ENABLED=true

# Sets the Secure flag and the __Host- cookie prefix. Both require HTTPS, so
# this must stay false for http://localhost, and must be true in any real
# deployment.
SECURE_COOKIES=false

# ---- Web ------------------------------------------------------------------

WEB_PORT=5173
